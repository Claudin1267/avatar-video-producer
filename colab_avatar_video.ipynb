   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🎤 FASE 2: Importar o Avatar Video Processor"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from avatar_video_processor import AvatarVideoProducer, TTSEngine\n",
    "import os\n",
    "\n",
    "# Inicializar producer\n",
    "producer = AvatarVideoProducer(work_dir='/content/avatar-producer')\n",
    "print(\"✅ Avatar Video Producer inicializado!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 📸 FASE 3: Upload da Imagem do Avatar"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fazer upload da imagem\n",
    "from google.colab import files\n",
    "import cv2\n",
    "from PIL import Image\n",
    "\n",
    "print(\"📸 Envie a imagem do avatar (PNG ou JPG)...\")\n",
    "uploaded = files.upload()\n",
    "\n",
    "if uploaded:\n",
    "    filename = list(uploaded.keys())[0]\n",
    "    avatar_image_path = f'/content/avatar-producer/inputs/{filename}'\n",
    "    \n",
    "    # Mover e otimizar imagem\n",
    "    img = cv2.imread(filename)\n",
    "    if img is not None:\n",
    "        # Redimensionar para 512x512 se necessário\n",
    "        h, w = img.shape[:2]\n",
    "        if w > 1280 or h > 1280:\n",
    "            scale = min(1280/w, 1280/h)\n",
    "            img = cv2.resize(img, (int(w*scale), int(h*scale)))\n",
    "        \n",
    "        cv2.imwrite(avatar_image_path, img)\n",
    "        print(f\"✅ Avatar salvo: {avatar_image_path}\")\n",
    "        print(f\"   Dimensões: {img.shape[1]}x{img.shape[0]}\")\n",
    "    else:\n",
    "        print(\"❌ Erro ao ler imagem\")\nelse:\n",
    "    print(\"⚠️  Nenhum arquivo enviado\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## ✍️ FASE 4: Escrever o Script"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Digite o script aqui (máximo ~50 palavras para 10 segundos)\n",
    "script = \"\"\"\n",
    "Olá! Bem-vindo ao Avatar Video Producer.\n",
    "Sou um avatar de inteligência artificial.\n",
    "Posso falar e fazer vídeos em segundos!\n",
    "Tudo 100% grátis no Google Colab.\n",
    "Vamos produzir conteúdo incrível!\n",
    "\"\"\".strip()\n",
    "\n",
    "print(f\"📝 Script: {len(script.split())} palavras\")\n",
    "print(f\"Conteúdo:\\n{script}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🚀 FASE 5: Gerar Vídeo com Avatar Falando"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Produzir vídeo\n",
    "output_video = '/content/avatar-producer/outputs/avatar_video.mp4'\n",
    "\n",
    "success = producer.produce(\n",
    "    text=script,\n",
    "    avatar_image_path=avatar_image_path,\n",
    "    output_path=output_video,\n",
    "    duration_max=10\n",
    ")\n",
    "\n",
    "if success:\n",
    "    print(\"\\n🎉 VÍDEO GERADO COM SUCESSO!\")\nelse:\n",
    "    print(\"\\n⚠️  Verificar logs acima\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
